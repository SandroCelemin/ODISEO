def set_intent(value):
    st.session_state.intent_ui = value

def reset_state_show():    
    st.session_state.show_user_items = False
    st.session_state.detail_item = None
    st.session_state.show_chains = False
    st.session_state.detail_chain = None
    st.session_state.show_notifications = False

def apply_search():
    reset_state_show()
    st.session_state.search_text = st.session_state.search_ui
    st.session_state.search_text_mode = st.session_state.intent_ui
    st.session_state.detail_item = None
    #st.rerun(scope="app")

def _init_header_session_state():
    """Inicialización rápida de Session State"""
    if "search_ui" not in st.session_state:
        st.session_state.search_ui = ""
    if "intent_ui" not in st.session_state:
        st.session_state.intent_ui = "want"
    if "show_login" not in st.session_state:
        st.session_state.show_login = False
    if "show_create" not in st.session_state:
        st.session_state.show_create = False

#@st.fragment
def render_header():    
    st.markdown(HEADER_CSS, unsafe_allow_html=True)
    
    # ───── INIT ─────
    _init_header_session_state()
    
    # Evaluación en una sola variable booleana para evitar consultas repetidas al state
    is_have = (st.session_state.intent_ui == "have")

    # =================
    # Texto explicativo
    # =================
    if is_have:
        placeholder = "Quin article tens per intercanviar"
        subheader_text = "Què puc aconseguir amb el que tinc?"
    else:
        placeholder = "Quin article vols aconseguir"
        subheader_text = "Com puc aconseguir el que vull?"

    # =============================================
    # Cabecera: LOGO
    # =============================================
    with st.container():
        
        st.markdown("<div class='fila-superior-fija'></div>", unsafe_allow_html=True)
        
        col_logo, _ = st.columns(2)
        with col_logo:
            st.markdown("<div class='logo'>ODISEO</div>", unsafe_allow_html=True)
            
        # =========================
        # Fila con todo para buscar
        # =========================
        #col_btn_type, col_contextual_text, col_search_bar, col_btn = st.columns([2.7, 5.9, 13, 2], vertical_alignment="center")
        
        c_btn1, c_btn2, col_contextual_text, col_search_bar, col_btn = st.columns(
            [1.35, 1.35, 5.9, 13, 2], 
            vertical_alignment="center"
        )

        #with col_btn_type:
        #    t1, t2= st.columns([1, 1])

        #    with t1:
        with c_btn1:
            st.button(
                "Vull",
                use_container_width=True,
                type="primary" if st.session_state.intent_ui == "want" else "secondary",
                on_click=set_intent,
                args=("want",)
            )

            #with t2:
        with c_btn2:
            st.button(
                "Tinc",
                use_container_width=True,
                type="primary" if st.session_state.intent_ui == "have" else "secondary",
                on_click=set_intent,
                args=("have",)
            )
        
        with col_contextual_text:
            #if st.session_state.intent_ui == "have":
            #    st.subheader("Qué puedo conseguir con lo que tengo?")
            #else:
            #    st.subheader("Cómo puedo conseguir lo que quiero?")
            st.subheader(subheader_text)

        with col_search_bar:
            st.text_input(
                "",
                placeholder=placeholder,
                key="search_ui",
                label_visibility="collapsed",
                icon=":material/search:",
                on_change=apply_search
            )

        with col_btn:
            st.button("Cercar", on_click=apply_search)
